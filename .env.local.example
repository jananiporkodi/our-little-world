# The one shared secret that unlocks the app. Change this to something only
# the two of you know before you share the app with each other.
APP_PASSCODE=change-me

# Supabase project connection. Find these in Supabase Studio under
# Project Settings -> API. Note: this key is intentionally NOT prefixed with
# NEXT_PUBLIC_ -- it must stay server-only. See src/lib/supabase/server.ts.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
